# OpenRouter API Key
# 请将此文件复制为 .env.local 并填入您的 OpenRouter API Key
# 获取地址: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# 默认模型 (可选，如不设置则使用代码中的默认值)
# 推荐模型: anthropic/claude-3.5-sonnet, openai/gpt-4o, google/gemini-2.0-flash-exp
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet

